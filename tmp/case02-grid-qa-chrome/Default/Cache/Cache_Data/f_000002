/* Approved targeted fixes: desktop App hierarchy, two transitions, and source-evidence viewer. */
@media(min-width:901px){
  .qfc-transition{margin-top:88px;padding:48px 0 62px}
  .qfc-service{padding-bottom:100px}
  .qfc-space{margin-top:98px;padding-top:144px}
  .qfc-app-evidence{grid-template-columns:minmax(250px,1.1fr) repeat(2,minmax(0,.85fr));grid-template-rows:auto auto;gap:28px 36px;align-items:start}
  .qfc-app-evidence figure:first-child{grid-column:1;grid-row:1 / span 2;align-self:start}
  .qfc-app-evidence figure:first-child img{height:570px}
  .qfc-app-evidence figure:nth-child(2){grid-column:2;grid-row:1}
  .qfc-app-evidence figure:nth-child(3){grid-column:3;grid-row:1}
  .qfc-app-evidence figure:nth-child(4){grid-column:2;grid-row:2}
  .qfc-app-evidence__support{grid-column:3;grid-row:2;align-self:auto;margin-top:0;opacity:.78}
  .qfc-app-evidence figure img,.qfc-app-evidence figure:nth-child(2) img,.qfc-app-evidence figure:nth-child(4) img,.qfc-app-evidence__support img{height:244px!important}
}
.qfc-case [data-qfc-lightbox] img{cursor:zoom-in}
.qfc-case [data-qfc-lightbox] img:focus-visible{outline:2px solid var(--q-green);outline-offset:4px}
.qfc-lightbox{width:min(1180px,calc(100% - 40px));max-width:none;max-height:calc(100% - 40px);padding:0;border:0;background:transparent;color:var(--q-ink)}
.qfc-lightbox::backdrop{background:rgba(16,28,20,.78)}
.qfc-lightbox__panel{position:relative;display:grid;gap:12px;max-height:calc(100vh - 40px);padding:44px 18px 18px;background:var(--q-paper);box-shadow:0 20px 60px rgba(0,0,0,.28)}
.qfc-lightbox__image{display:block;max-width:100%;max-height:calc(100vh - 128px);margin:auto;object-fit:contain}
.qfc-lightbox__panel p{margin:0;color:var(--q-muted);font-size:12px;line-height:1.55}
.qfc-lightbox__close{position:absolute;top:12px;right:14px;padding:6px 8px;border:1px solid var(--q-line);border-radius:0;background:#fff;color:var(--q-ink);font:inherit;font-size:12px;cursor:pointer}
.qfc-lightbox__close:hover,.qfc-lightbox__close:focus-visible{border-color:var(--q-green);color:var(--q-green)}
@media(max-width:520px){.qfc-lightbox{width:calc(100% - 24px);max-height:calc(100% - 24px)}.qfc-lightbox__panel{max-height:calc(100vh - 24px);padding:42px 10px 12px}.qfc-lightbox__image{max-height:calc(100vh - 105px)}.qfc-lightbox__panel p{font-size:11px}.qfc-lightbox__close{top:9px;right:10px}}

/* Final Desktop evidence delivery: preserve complete original board bounds. */
@media(min-width:901px){
  .qfc-research__image img,
  .qfc-journey-evidence img{height:auto;max-height:none;object-fit:contain;object-position:center}
}

/* Chapter 06: align each App touchpoint one-to-one with the five service stages. */
@media(min-width:901px){
  .qfc-app-evidence{
    grid-template-columns:repeat(5,minmax(0,1fr));
    grid-template-rows:minmax(0,auto);
    gap:0;
    align-items:start;
  }
  .qfc-app-evidence > figure:nth-child(1),
  .qfc-app-evidence > figure:nth-child(2),
  .qfc-app-evidence > figure:nth-child(3),
  .qfc-app-evidence > figure:nth-child(4),
  .qfc-app-evidence > figure:nth-child(5){
    grid-row:1;
    align-self:start;
    min-width:0;
    margin-top:0;
  }
  .qfc-app-evidence > figure:nth-child(1){grid-column:1}
  .qfc-app-evidence > figure:nth-child(2){grid-column:2}
  .qfc-app-evidence > figure:nth-child(3){grid-column:3}
  .qfc-app-evidence > figure:nth-child(4){grid-column:4}
  .qfc-app-evidence > figure:nth-child(5){grid-column:5;opacity:.78}
  .qfc-app-evidence > figure:nth-child(1) img,
  .qfc-app-evidence > figure:nth-child(2) img,
  .qfc-app-evidence > figure:nth-child(3) img,
  .qfc-app-evidence > figure:nth-child(4) img,
  .qfc-app-evidence > figure:nth-child(5) img{
    width:100%;
    height:244px!important;
  }
  .qfc-app-evidence figcaption{min-height:24px;}
}
